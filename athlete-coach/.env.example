# Copie para .env e preencha. O .env nunca vai para o repositório.
#
# As duas primeiras vêm de https://www.strava.com/settings/api
# (crie um app; o "Authorization Callback Domain" pode ser localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Preenchidas sozinhas por scripts/strava_export.py depois do primeiro OAuth.
# Deixe vazias no primeiro uso.
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=

# Personal API oficial do Garmin (preferida). Gere em Garmin Connect web →
# Configurações → Personal API Key. A chave aparece uma vez só e expira no prazo
# que você escolher; o token de 24 h é trocado sozinho a partir dela.
GARMIN_PERSONAL_API_KEY=
# Opcional: só se o teste exploratório mostrar que as rotas de wellness pedem
# o displayName no caminho (ele aparece em dados/exploracao_personal/*/perfil.json)
GARMIN_DISPLAY_NAME=

# Conta do Garmin Connect para a biblioteca não-oficial (garminconnect).
# Com a Personal API configurada, só é usada como fallback para o VO2max.
# Só é lida no primeiro login; depois a sessão fica salva em dados/.garmin_tokens
# e a senha deixa de ser necessária a cada execução.
GARMIN_EMAIL=
GARMIN_PASSWORD=
