# Copie para .env e preencha. O .env nunca vai para o repositório.
#
# As duas primeiras vêm de https://www.strava.com/settings/api
# (crie um app; o "Authorization Callback Domain" pode ser localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Preenchidas sozinhas por scripts/strava_export.py depois do primeiro OAuth.
# Deixe vazias no primeiro uso.
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=
